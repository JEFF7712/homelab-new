#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=hooks/common.sh
source "$(dirname "$0")/common.sh"
hook_load || hook_ok
[[ -n ${AGENT_TASK_ID:-} ]] || hook_ok
resume=$(AGENT_HOOK_ACTIVE=1 timeout 5 python -m scripts.agent task-resume "$AGENT_TASK_ID" --json 2>/dev/null) || hook_ok
needs=$(jq -r '.checkpoint.head_drift or .checkpoint.fingerprint_drift or ([.verifications[]? | select(.stale or .exit_code != 0)] | length > 0)' <<<"$resume")
[[ $needs == true ]] || hook_ok
message="Task $AGENT_TASK_ID has checkout drift or unresolved validation. Run just task-checkpoint $AGENT_TASK_ID before handoff."
jq -n --arg value "$message" '{followup_message:$value,hookSpecificOutput:{additionalContext:$value}}'
